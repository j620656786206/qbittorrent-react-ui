# qBittorrent WebUI as seen from inside this container.
QBIT_URL=http://qbittorrent.example:8080
QBIT_USERNAME=change-me
QBIT_PASSWORD=change-me

# `openssl rand -base64 32`. At least 32 bytes; the placeholder below is
# refused at startup. Changing it logs every device out.
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Comma-separated origins the browser uses to reach this container: scheme,
# host and optional port, no path or trailing slash. List every address you
# use, e.g. http://nas.example:3000,https://torrent.example.com
APP_ORIGINS=http://localhost:3000

# Comma-separated absolute download roots as seen inside the qBittorrent
# container (not this one).
SAVE_ROOTS=/downloads

# Where settings.json lives. Defaults to /config; locally a gitignored folder.
CONFIG_DIR=./config
